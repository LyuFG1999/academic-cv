---
import { template } from '../settings'
const commit = process.env.GITHUB_SHA ?? process.env.COMMIT_REF ?? 'local'
---
<meta name='site-deployment' content={commit} />
<script is:inline define:vars={{ commit, base: template.base }}>
(() => {
  // Version page links to avoid reusing a document from an earlier maintenance build.
  const stampLinks = () => {
    for (const a of document.querySelectorAll('a[href]')) {
      const url = new URL(a.href, location.href);
      if (url.origin !== location.origin || !url.pathname.startsWith(base + '/') || a.hasAttribute('download')) continue;
      const local = url.pathname.slice(base.length);
      if (!/^\/(zh|en)(\/|$)/.test(local) || /\.[a-z0-9]+$/i.test(local)) continue;
      url.searchParams.set('v', commit); a.href = url.href;
    }
  };
  let checking = false;
  const check = async () => {
    if (checking || document.hidden || commit === 'local') return;
    checking = true;
    try {
      const response = await fetch(base + '/admin/deployment.json?t=' + Date.now(), { cache: 'no-store' });
      if (!response.ok) return;
      const live = await response.json();
      if (!/^[a-f0-9]{40}$/.test(live.commit) || live.commit === commit) return;
      // One recovery per version/path prevents a reload loop during CDN propagation.
      const key = 'site-recovery:' + live.commit + ':' + location.pathname;
      if (sessionStorage.getItem(key)) return;
      sessionStorage.setItem(key, '1');
      const next = new URL(location.href); next.searchParams.set('v', live.commit); location.replace(next);
    } catch {} finally { checking = false; }
  };
  document.addEventListener('DOMContentLoaded', stampLinks);
  window.addEventListener('pageshow', check);
  document.addEventListener('visibilitychange', check);
  setInterval(check, 30000);
})();
</script>
