---
import { maintenance, profile, social, template } from '@/settings'
import { safeHttpUrl } from '@/lib/utils'
import type { Language } from '@/i18n'
interface Props {
	lang: Language
	title: string
	description: string
	image: string
	alternatePath: string
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const { lang, image, alternatePath } = Astro.props
const title = maintenance.enabled ? maintenance.title[lang] : Astro.props.title
const description = maintenance.enabled ? maintenance.message[lang] : Astro.props.description
const imagePath = image.startsWith('http')
	? image
	: `${template.base}${image.startsWith('/') ? image : `/${image}`}`
const socialImageURL = new URL(imagePath, Astro.site)
const hasShareImage = !socialImageURL.pathname.toLowerCase().endsWith('.svg')
const otherLanguage = lang === 'zh' ? 'en' : 'zh'
const alternateURL = new URL(alternatePath, Astro.site)
const defaultURL = new URL(`${template.base}/zh/`, Astro.site)
const sameAs = Object.entries(social)
	.filter(([key, item]) => key !== 'email' && item.enabled)
	.map(([, item]) => safeHttpUrl(item.url))
	.filter((url): url is string => Boolean(url))
const personJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile[lang].fullName,
	jobTitle: profile[lang].title,
	affiliation: profile[lang].institute ? { '@type': 'Organization', name: profile[lang].institute } : undefined,
	url: canonicalURL.toString(),
	image: socialImageURL.toString(),
	sameAs,
}).replace(/</g, '\\u003c')
---

<meta charset='utf-8' />
<meta name='viewport' content='width=device-width,initial-scale=1' />
<link
	rel='icon'
	type='image/svg+xml'
	href='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎓</text></svg>'
/>
<!-- Sitemap -->
<link rel="sitemap" href={`${template.base}/sitemap-index.xml`} />

<!-- Canonical URL -->
<link rel='canonical' href={canonicalURL} />
<link rel='alternate' hreflang={lang} href={canonicalURL} />
<link rel='alternate' hreflang={otherLanguage} href={alternateURL} />
<link rel='alternate' hreflang='x-default' href={defaultURL} />
<link rel='alternate' type='application/rss+xml' title={`${title} RSS`} href={`${template.base}/${lang}/rss.xml`} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name='title' content={title} />
<meta name='description' content={description} />

<!-- Open Graph / Facebook -->
<meta property='og:type' content='website' />
<meta property='og:url' content={Astro.url} />
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
{!maintenance.enabled && hasShareImage && <meta property='og:image' content={socialImageURL} />}
<meta property='og:locale' content={lang === 'zh' ? 'zh_CN' : 'en_US'} />

<!-- Twitter -->
<meta name='twitter:card' content='summary_large_image' />
<meta name='twitter:url' content={Astro.url} />
<meta name='twitter:title' content={title} />
<meta name='twitter:description' content={description} />
{!maintenance.enabled && hasShareImage && <meta name='twitter:image' content={socialImageURL} />}

{!maintenance.enabled && <script is:inline type='application/ld+json' set:html={personJsonLd} />}
{maintenance.enabled && <meta name='robots' content='noindex,nofollow' />}

<!-- Restore the selected theme before first paint. -->
<script is:inline define:vars={{ lightTheme: template.lightTheme, darkTheme: template.darkTheme }}>
	document.documentElement.classList.add('js')
	let stored
	try { stored = localStorage.getItem('site-theme-mode') } catch {}
	const mode = stored === 'dark' || stored === darkTheme
		? 'dark'
		: stored === 'light' || stored === lightTheme
			? 'light'
			: (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
	document.documentElement.dataset.themeMode = mode
	document.documentElement.dataset.theme = mode === 'dark' ? darkTheme : lightTheme
	if (!window.__academicThemeSwapReady) {
		window.__academicThemeSwapReady = true
		document.addEventListener('astro:before-swap', (event) => {
			const currentRoot = document.documentElement
			const nextRoot = event.newDocument.documentElement
			nextRoot.classList.add('js')
			nextRoot.dataset.themeMode = currentRoot.dataset.themeMode
			nextRoot.dataset.theme = currentRoot.dataset.theme
		})
	}
</script>
