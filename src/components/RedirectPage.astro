---
interface Props {
  to: string
}

const { to } = Astro.props
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={to} />
    <title>正在跳转…</title>
    <script is:inline define:vars={{ to }}>
      window.location.replace(to)
    </script>
  </head>
  <body>
    <a href={to}>进入网站</a>
  </body>
</html>
