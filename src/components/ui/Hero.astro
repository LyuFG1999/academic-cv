---
import { copy, type Language } from '@/i18n'

type Props = {
	lang: Language
	fullName: string
	title: string
	institute: string
	intro: string
}

const { lang, fullName, title, institute, intro } = Astro.props
const t = copy[lang]
---

<div class='max-w-4xl py-8 sm:py-12'>
	<p class='mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-secondary'>{t.introPrefix}</p>
	<h1 class='bg-gradient-to-br from-base-content via-base-content to-primary bg-clip-text text-5xl font-black leading-tight text-transparent sm:text-7xl'>{fullName}</h1>
	<p class='mt-7 text-xl font-medium text-base-content/65'>{title}{institute ? ` · ${institute}` : ''}</p>
	<p class='mt-8 max-w-2xl text-lg leading-8 text-base-content/80'>{intro}</p>
</div>
