---
import { tokenizeAuthors } from '@/lib/utils'

type Props = {
	authors: string
	authorName: string
}

const { authors, authorName } = Astro.props
const tokens = tokenizeAuthors(authors, authorName)
---

<span>
	{tokens.map((token) => token.highlighted
		? <strong class='rounded bg-primary/12 px-1 font-semibold text-primary underline decoration-primary/40 decoration-2 underline-offset-4'>{token.text}</strong>
		: token.text)}
</span>
