---
import Envelope from '@/assets/social-icons/envelope.svg'
import GitHub from '@/assets/social-icons/github.svg'
import X from '@/assets/social-icons/x-twitter.svg'
import Orcid from '@/assets/social-icons/orcid.svg'
import Cnki from '@/assets/social-icons/cnki.svg'
import { copy, type Language } from '@/i18n'
import { social } from '@/settings'

type Props = { lang: Language }
const { lang } = Astro.props
const t = copy[lang]
const contacts = [
	{ key: 'email', label: t.email, value: social.email, href: social.email ? `mailto:${social.email}` : '', Icon: Envelope },
	{ key: 'github', label: t.github, value: social.github, href: social.github, Icon: GitHub },
	{ key: 'x', label: t.x, value: social.x, href: social.x, Icon: X },
	{ key: 'orcid', label: t.orcid, value: social.orcid, href: social.orcid, Icon: Orcid },
	{ key: 'cnki', label: t.cnki, value: social.cnki, href: social.cnki, Icon: Cnki },
]
---

<section aria-label={t.contact}>
	<h2 class='mb-3 px-2 text-xs font-bold uppercase tracking-[0.18em] text-base-content/50'>{t.contact}</h2>
	<ul class='space-y-1'>
		{contacts.map(({ label, value, href, Icon }) => (
			<li>
				{value ? (
					<a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'me noopener noreferrer' : undefined} class='group flex items-center gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-primary/15' aria-label={label}>
						<span class='grid size-8 place-items-center rounded-lg bg-base-100 shadow-sm'><Icon class='size-5' fill='currentColor' /></span>
						<span class='text-sm font-medium'>{label}</span>
					</a>
				) : (
					<div class='flex items-center gap-3 rounded-xl px-3 py-2.5 text-base-content/40' aria-label={`${label}: ${t.pending}`}>
						<span class='grid size-8 place-items-center rounded-lg bg-base-100/60'><Icon class='size-5' fill='currentColor' /></span>
						<span class='text-sm'>{label}</span><span class='ml-auto text-xs'>{t.pending}</span>
					</div>
				)}
			</li>
		))}
	</ul>
</section>
