---
interface Props {
  gridTitle: string
  gridItems: {
    title: string
    description: string
    field?: string
  }[]
}

const { gridTitle, gridItems } = Astro.props
---
<h2 class="mb-8 text-3xl font-bold">{gridTitle}</h2>
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {gridItems.map((item) => (
    <div class="rounded-xl border border-base-300/70 bg-base-100 px-5 py-4 text-base-content transition hover:-translate-y-0.5 hover:border-secondary/35 hover:shadow-sm">
      <h3 class="text-lg font-semibold leading-snug">{item.title}</h3>
      {item.description?.trim() && (
        <p class="mt-2 text-sm leading-relaxed text-base-content/70">{item.description}</p>
      )}
    </div>
  ))}
</div>
