---
import { localizedPath, type Language } from '@/i18n'
import { profile, template } from '@/settings'
import { navigation, navigationLabel, navigationOrder } from '@/data/navigation'

type Props = { lang: Language }
const { lang } = Astro.props
const person = profile[lang]
const navItems = navigationOrder
	.filter(({ key }) => navigation[key].enabled)
	.map(({ key, path }) => ({ label: navigationLabel(key, lang), path: localizedPath(lang, path) }))
---

<aside class='site-sidebar flex h-screen w-64 flex-col overflow-y-auto border-r border-base-300/70 bg-base-100 px-5 py-8 text-base-content'>
	<div class='flex min-h-full flex-col'>
		<div class='flex flex-col items-center pt-3'>
			<div class='rounded-full border border-base-300 p-1.5'><img class='size-20 rounded-full object-cover' src={`${template.base}${person.avatar}`} alt={person.fullName} width='80' height='80' loading='eager' /></div>
			<p class='mt-5 text-center text-xl font-bold tracking-tight'>{person.fullName}</p>
			<p class='mt-1 text-center text-sm text-base-content/65'>{person.title}</p>
		</div>

		<nav class='mt-8' aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
			<ul class='menu gap-1 p-0 text-base'>
				{navItems.map((item) => {
					const href = `${template.base}${item.path}`
					const active = Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '')
					return <li><a href={href} class:list={['group rounded-2xl px-4 py-3 font-medium transition-colors duration-150', { active }]} aria-current={active ? 'page' : undefined}><span class:list={['mr-3 inline-block size-1.5 rounded-full transition-colors', active ? 'bg-primary-content shadow-[0_0_0_.3rem_rgba(255,255,255,.13)]' : 'bg-base-content/20 group-hover:bg-primary']}></span>{item.label}</a></li>
				})}
			</ul>
		</nav>

	</div>
</aside>
