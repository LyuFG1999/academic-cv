---
import type { Publication } from '@/types/cv'
import type { Language } from '@/i18n'
import { copy } from '@/i18n'
import { safeHttpUrl } from '@/lib/utils'
import AuthorNames from './AuthorNames.astro'

interface Props {
	elements: Publication[]
	lang: Language
	authorName: string
}

const { elements, lang, authorName } = Astro.props
const t = copy[lang]
---
<ul class='space-y-8'>
  {elements.map((element) => {
    const link = safeHttpUrl(element.link)
    return (
    <li class='group'>
      {link
        ? <a href={link} class='block transition-colors duration-200 hover:text-accent' target='_blank' rel='noopener noreferrer'><h3 class='mb-2 text-lg font-bold'>{element.title}</h3></a>
        : <h3 class='mb-2 text-lg font-bold'>{element.title}</h3>}
      <p class='text-base mb-2'>
        <span class='font-medium'>{t.authors}:</span>{' '}
        <AuthorNames authors={element.authors} authorName={authorName} />
      </p>
      <p class='text-sm mb-3'>
        <span class='italic'>{element.journal}</span> •{' '}
        {element.time}
      </p>
      {element.abstract && <p>{element.abstract}</p>}
    </li>
  )})}
</ul>
