---
import { isExperience } from '@/types/cv'
import type { Experience, Education } from '@/types/cv'

interface Props {
	elements: (Experience | Education)[]
	colored: boolean
}

const { elements, colored } = Astro.props
---

<ol class='relative space-y-5 pl-8 sm:pl-10'>
	<div class:list={['absolute bottom-4 left-[0.72rem] top-4 w-px sm:left-[0.9rem]', colored ? 'bg-secondary/35' : 'bg-base-300']} aria-hidden='true'></div>
	{elements.map((element) => {
		const experience = isExperience(element)
		const title = experience ? element.title : element.degree
		const organization = experience ? element.company : element.school
		return (
			<li class='relative'>
				<div class:list={[
					'absolute -left-8 top-6 grid size-6 place-items-center rounded-full border text-xs shadow-sm sm:-left-10 sm:size-7',
					colored ? 'border-secondary/25 bg-secondary/12 text-secondary' : 'border-base-300 bg-base-100 text-base-content/65',
				]} aria-hidden='true'>
					<span>{experience ? '💼' : '🎓'}</span>
				</div>
				<article class='rounded-2xl border border-base-300 bg-base-200/55 p-5 transition duration-300 hover:-translate-y-0.5 hover:border-secondary/30 hover:bg-base-200 sm:p-6'>
					<div class='flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between'>
						<div class='min-w-0'>
							<h3 class='text-lg font-bold leading-snug text-base-content sm:text-xl'>{title}</h3>
							<p class='mt-1.5 font-medium text-secondary'>{organization}</p>
						</div>
						<time class='w-fit shrink-0 rounded-full border border-base-300 bg-base-100 px-3 py-1 text-sm font-medium text-base-content/65'>{element.time}</time>
					</div>
					{(element.location || element.description) && <div class='mt-4 border-t border-base-300/80 pt-4'>
						{element.location && <p class='text-sm text-base-content/55'>📍 {element.location}</p>}
						{element.description && <p class='mt-2 leading-relaxed text-base-content/72'>{element.description}</p>}
					</div>}
				</article>
			</li>
		)
	})}
</ol>
