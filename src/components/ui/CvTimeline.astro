---
import { isExperience } from '@/types/cv'
import type { Experience, Education } from '@/types/cv'

interface Props {
	elements: (Experience | Education)[]
	colored: boolean
}

const { elements } = Astro.props
---

<ol class='cv-timeline relative space-y-5 pl-6 sm:pl-8'>
	<div class='absolute bottom-4 left-[0.34rem] top-4 w-[2px] rounded-full bg-secondary/40' aria-hidden='true'></div>
	{elements.map((element) => {
		const experience = isExperience(element)
		const title = experience ? element.title : element.degree
		const organization = experience ? element.company : element.school
		return (
			<li class='relative min-w-0'>
				<span class='absolute -left-6 top-6 block size-[0.8rem] rounded-full border-[3px] border-base-100 bg-secondary ring-2 ring-secondary/30 sm:-left-8 sm:top-7' aria-hidden='true'></span>
				<article class='cv-entry min-w-0 rounded-2xl border border-base-300 bg-base-200/55 p-4 transition duration-300 hover:-translate-y-0.5 hover:border-secondary/30 hover:bg-base-200 sm:p-6'>
					<div class='flex min-w-0 flex-col gap-3 sm:flex-row sm:items-start sm:justify-between'>
						<div class='min-w-0'>
							<h3 class='min-w-0 text-lg font-bold leading-snug text-base-content sm:text-xl'>{title}</h3>
							<p class='mt-1.5 min-w-0 font-medium text-secondary'>{organization}</p>
						</div>
						<time class='w-fit max-w-full shrink-0 rounded-full border border-base-300 bg-base-100 px-3 py-1 text-sm font-medium text-base-content/65'>{element.time}</time>
					</div>
					{(element.location || element.description) && <div class='mt-4 min-w-0 border-t border-base-300/80 pt-4'>
						{element.location && (
							<p class='flex min-w-0 items-start gap-2 text-sm text-base-content/55'>
								<span class='mt-0.5 inline-grid size-5 shrink-0 place-items-center rounded-full bg-secondary' aria-hidden='true'>
									<svg viewBox='0 0 24 24' class='size-3.5 fill-white'>
										<path d='M12 22s7-6.2 7-13a7 7 0 1 0-14 0c0 6.8 7 13 7 13Zm0-9.25A3.75 3.75 0 1 1 12 5a3.75 3.75 0 0 1 0 7.75Z'></path>
									</svg>
								</span>
								<span class='min-w-0 break-words'>{element.location}</span>
							</p>
						)}
						{element.description && <p class='mt-2 min-w-0 break-words leading-relaxed text-base-content/72'>{element.description}</p>}
					</div>}
				</article>
			</li>
		)
	})}
</ol>

<style>
	.cv-timeline, .cv-entry { max-width: 100%; }
	.cv-entry :global(h3), .cv-entry :global(p), .cv-entry :global(time) { overflow-wrap: anywhere; }
	@media (max-width: 640px) {
		.cv-timeline { width: 100%; }
	}
</style>
