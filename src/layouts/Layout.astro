---
import { ClientRouter, fade } from 'astro:transitions'
import '@/styles/site.css'
import BetterIcon from '@/components/ui/BetterIcon.astro'
import DarkLightController from '@/components/ui/DarkLightController.astro'
import Navbar from '@/components/ui/Navbar.astro'
import Footer from '@/components/ui/Footer.astro'
import Head from '@/components/Head.astro'
import IntroGate from '@/components/ui/IntroGate.astro'
import MaintenanceScreen from '@/components/ui/MaintenanceScreen.astro'
import { appearance, maintenance, seo, profile, template } from '@/settings'
import { copy, type Language } from '@/i18n'

type Props = {
	lang?: Language
	title?: string
	description?: string
	image?: string
	immersiveIntro?: boolean
}

const { lang = 'zh', title, description, image, immersiveIntro = false } = Astro.props
const localizedSeo = seo[lang]
const pageTitle = title ?? localizedSeo.defaultTitle
const pageDescription = description ?? localizedSeo.defaultDescription
const person = profile[lang]
const pageImage = image ?? person.avatar
const otherLanguage: Language = lang === 'zh' ? 'en' : 'zh'
const currentWithoutBase = Astro.url.pathname.startsWith(template.base)
	? Astro.url.pathname.slice(template.base.length)
	: Astro.url.pathname
const switchedPath = /^\/(zh|en)\/blog\/.+/.test(currentWithoutBase)
	? `/${otherLanguage}/blog`
	: currentWithoutBase.replace(`/${lang}`, `/${otherLanguage}`) || `/${otherLanguage}`
const languagePath = `${template.base}${switchedPath}`
---

<!doctype html>
<html lang={lang}>
	<head>
		{template.transitions && <ClientRouter />}
		<Head lang={lang} title={pageTitle} description={pageDescription} image={pageImage} alternatePath={languagePath} />
	</head>
	<body transition:animate={fade({ duration: '90ms' })}>
		{maintenance.enabled ? <MaintenanceScreen lang={lang} /> : <>
		{immersiveIntro && appearance.introEnabled && <IntroGate lang={lang} />}
		<div class='min-h-screen bg-base-100 drawer lg:drawer-open' data-site-shell>
			<input id='site-drawer' type='checkbox' class='drawer-toggle' />
			<div class='drawer-content min-w-0 overflow-x-hidden bg-transparent'>
				<main tabindex='-1' class='site-main'>
					<div class='main-flow'>
					<nav class='page-tools' aria-label={lang === 'zh' ? '页面选项' : 'Page options'}>
							<label for='site-drawer' class='btn btn-square btn-ghost lg:hidden' aria-label={lang === 'zh' ? '打开菜单' : 'Open menu'}>
								<BetterIcon>
									<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke-width='1.5' class='size-6 stroke-current'>
										<path stroke-linecap='round' stroke-linejoin='round' d='M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5'></path>
									</svg>
								</BetterIcon>
							</label>
							<a href={languagePath} class='btn btn-ghost language-control' hreflang={otherLanguage} aria-label={copy[lang].language} title={copy[lang].language}>
								<span>{lang === 'zh' ? 'EN' : '中文'}</span>
							</a>
							<DarkLightController lang={lang} />
					</nav>
					<div class='page-content'><slot /></div>
					</div>
					<Footer lang={lang} />
				</main>
			</div>
			<div class='drawer-side z-40'>
				<label for='site-drawer' aria-label={lang === 'zh' ? '关闭菜单' : 'Close menu'} class='drawer-overlay'></label>
				<Navbar lang={lang} />
			</div>
		</div>
		</>}
	</body>
</html>

<script is:inline>
	(() => {
	if (window.__academicRevealInstalled) return
	window.__academicRevealInstalled = true
	let currentObserver
	const initializeReveal = () => {
		currentObserver?.disconnect()
		const elements = document.querySelectorAll('[data-reveal]')
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			elements.forEach((element) => element.classList.add('is-visible'))
			return
		}
		if (!('IntersectionObserver' in window)) {
			elements.forEach((element) => element.classList.add('is-visible'))
			return
		}
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible')
					observer.unobserve(entry.target)
				}
			})
		}, { threshold: 0.12 })
		currentObserver = observer
		elements.forEach((element) => observer.observe(element))
	}
	initializeReveal()
	document.addEventListener('astro:page-load', initializeReveal)
	})()
</script>

<style is:global>
	iframe#nl-badge-frame, iframe[title='Powered by Netlify'] { display: none !important; visibility: hidden !important; }
	html { scroll-behavior: smooth; }
	:focus-visible { outline: 2px solid var(--fallback-p, oklch(var(--p))); outline-offset: 4px; }
	.site-main:focus { outline: none; }
	.site-main { width: 100%; max-width: 76rem; min-height: 100dvh; margin-inline: auto; padding: 3.5rem clamp(1.5rem, 5vw, 5rem) 1.5rem; display: flex; flex-direction: column; justify-content: space-between; }
	.main-flow { display: flow-root; }
	.page-tools { float: right; position: relative; z-index: 5; display: flex; align-items: center; gap: .45rem; margin: 0 0 1.5rem 1.5rem; }
	.page-tools .btn { min-height: 2.5rem; height: 2.5rem; border: 1px solid var(--fallback-b3, oklch(var(--b3))); background: var(--fallback-b1, oklch(var(--b1))); box-shadow: none; }
	.page-tools .btn-circle, .page-tools .btn-square { width: 2.5rem; }
	.language-control { padding-inline: .85rem; font-size: .75rem; letter-spacing: .03em; }
	.page-content > :first-child { min-height: 3rem; }
	.page-content h1 { overflow-wrap: anywhere; line-height: 1.2; }
	.page-content > :not(:first-child) { clear: both; }
	@media(max-width: 640px) { .site-main { padding-top: 1.5rem; } .page-tools { gap: .3rem; margin-left: .75rem; } .page-tools .btn { min-height: 2.25rem; height: 2.25rem; } .page-tools .btn-circle, .page-tools .btn-square { width: 2.25rem; } .page-content h1 { font-size: 2rem; } }
	.drawer-content { overflow: clip; }
	@media (min-width: 1024px) {
		[data-site-shell].drawer { display: block; padding-left: 16rem; }
		[data-site-shell].drawer > .drawer-toggle ~ .drawer-side { position: fixed; inset: 0 auto 0 0; height: 100dvh; width: 16rem; overflow: hidden; }
		.site-sidebar { height: 100dvh; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
	}
	body { margin: 0; min-height: 100%; overflow-x: hidden; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif; background-color: var(--fallback-b1, oklch(var(--b1))); background-image: radial-gradient(circle at 78% 10%, color-mix(in oklab, var(--fallback-p, oklch(var(--p))) 9%, transparent), transparent 30rem), radial-gradient(circle at 20% 85%, color-mix(in oklab, var(--fallback-s, oklch(var(--s))) 7%, transparent), transparent 28rem); }
	[data-site-shell] { transition: filter .9s ease, transform .9s cubic-bezier(.2,.75,.2,1); }
	.intro-active [data-site-shell] { filter: blur(10px); transform: scale(.985); }
	.intro-releasing [data-site-shell] { filter: none; transform: none; }
	.site-main h1, .site-main h2, .site-main h3 { letter-spacing: -.025em; }
	.card { border-radius: 1rem; box-shadow: 0 .4rem 1.8rem color-mix(in oklab, var(--fallback-bc, oklch(var(--bc))) 3%, transparent); transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease; }
	.card:hover { transform: translateY(-3px); border-color: color-mix(in oklab, var(--fallback-p, oklch(var(--p))) 35%, transparent); box-shadow: 0 1.4rem 3.4rem color-mix(in oklab, var(--fallback-p, oklch(var(--p))) 11%, transparent); }
	.btn { border-radius: 999px; }
	::selection { color: var(--fallback-pc, oklch(var(--pc))); background: var(--fallback-p, oklch(var(--p))); }
	.alert > span { min-width: 0; overflow-wrap: anywhere; }
	[data-reveal] {
		opacity: 1;
		transform: none;
		transition: opacity 150ms ease, transform 150ms ease;
	}
	.js [data-reveal]:not(.is-visible) { opacity: 0; transform: translateY(.3rem); }
	.js [data-reveal].is-visible { opacity: 1; transform: none; }
	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		.js [data-reveal]:not(.is-visible), [data-reveal] { opacity: 1; transform: none; transition: none; }
		.card, [data-site-shell] { transition: none; }
	}
</style>
