---
import { ClientRouter } from 'astro:transitions'
import BetterIcon from '@/components/ui/BetterIcon.astro'
import DarkLightController from '@/components/ui/DarkLightController.astro'
import Navbar from '@/components/ui/Navbar.astro'
import Footer from '@/components/ui/Footer.astro'
import Head from '@/components/Head.astro'
import IntroGate from '@/components/ui/IntroGate.astro'
import MaintenanceScreen from '@/components/ui/MaintenanceScreen.astro'
import { appearance, maintenance, seo, profile, template } from '@/settings'
import { copy, type Language } from '@/i18n'

type Props = {
	lang?: Language
	title?: string
	description?: string
	image?: string
	immersiveIntro?: boolean
}

const { lang = 'zh', title, description, image, immersiveIntro = false } = Astro.props
const localizedSeo = seo[lang]
const pageTitle = title ?? localizedSeo.defaultTitle
const pageDescription = description ?? localizedSeo.defaultDescription
const person = profile[lang]
const pageImage = image ?? person.avatar
const otherLanguage: Language = lang === 'zh' ? 'en' : 'zh'
const currentWithoutBase = Astro.url.pathname.startsWith(template.base)
	? Astro.url.pathname.slice(template.base.length)
	: Astro.url.pathname
const switchedPath = /^\/(zh|en)\/blog\/.+/.test(currentWithoutBase)
	? `/${otherLanguage}/blog`
	: currentWithoutBase.replace(`/${lang}`, `/${otherLanguage}`) || `/${otherLanguage}`
const languagePath = `${template.base}${switchedPath}`
---

<!doctype html>
<html lang={lang}>
	<head>
		{template.transitions && <ClientRouter />}
		<Head lang={lang} title={pageTitle} description={pageDescription} image={pageImage} alternatePath={languagePath} />
		{template.base === '' && <script is:inline src='https://identity.netlify.com/v1/netlify-identity-widget.js'></script>}
	</head>
	<body>
		{maintenance.enabled ? <MaintenanceScreen lang={lang} /> : <>
		{immersiveIntro && appearance.introEnabled && <IntroGate lang={lang} />}
		<div class='min-h-screen bg-base-100 drawer lg:drawer-open' data-site-shell>
			<input id='site-drawer' type='checkbox' class='drawer-toggle' />
			<div class='drawer-content min-w-0 overflow-x-hidden bg-transparent'>
				<div class='site-topbar sticky top-0 z-30 border-b border-base-300/60 bg-base-100/75 text-base-content backdrop-blur-xl'>
					<nav class='navbar px-4 lg:px-8'>
						<div class='navbar-start'>
							<label for='site-drawer' class='btn btn-square btn-ghost lg:hidden' aria-label={lang === 'zh' ? '打开菜单' : 'Open menu'}>
								<BetterIcon>
									<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke-width='1.5' class='size-6 stroke-current'>
										<path stroke-linecap='round' stroke-linejoin='round' d='M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5'></path>
									</svg>
								</BetterIcon>
							</label>
						</div>
						<div class='navbar-center lg:hidden text-base font-black'>{person.fullName}</div>
						<div class='navbar-end gap-2'>
							<a href={languagePath} class='btn btn-ghost rounded-full border border-base-300 bg-base-200/70 px-4' hreflang={otherLanguage} aria-label={copy[lang].language} title={copy[lang].language}>
								<span aria-hidden='true' class='font-black'>文 / A</span>
								<span class='hidden sm:inline'>{copy[lang].language}</span>
							</a>
							<DarkLightController lang={lang} />
						</div>
					</nav>
				</div>
				<main class='site-main mx-auto flex min-h-[calc(100vh-4rem)] min-w-0 w-full max-w-6xl flex-col justify-between overflow-x-hidden px-6 pb-4 pt-10 sm:px-10 lg:px-14 lg:pt-16'>
					<div><slot /></div>
					<Footer lang={lang} />
				</main>
			</div>
			<div class='drawer-side z-40'>
				<label for='site-drawer' aria-label={lang === 'zh' ? '关闭菜单' : 'Close menu'} class='drawer-overlay'></label>
				<Navbar lang={lang} />
			</div>
		</div>
		</>}
	</body>
</html>

<script is:inline>
	if (window.netlifyIdentity) {
		window.netlifyIdentity.on('init', (user) => {
			if (!user) {
				window.netlifyIdentity.on('login', () => {
					document.location.href = '/admin/'
				})
			}
		})
	}
</script>

<script is:inline>
	const initializeReveal = () => {
		const elements = document.querySelectorAll('[data-reveal]')
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			elements.forEach((element) => element.classList.add('is-visible'))
			return
		}
		if (!('IntersectionObserver' in window)) {
			elements.forEach((element) => element.classList.add('is-visible'))
			return
		}
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible')
					observer.unobserve(entry.target)
				}
			})
		}, { threshold: 0.12 })
		elements.forEach((element) => observer.observe(element))
	}
	initializeReveal()
	document.addEventListener('astro:page-load', initializeReveal)
</script>

<style is:global>
	html { scroll-behavior: smooth; }
	body { margin: 0; min-height: 100%; overflow-x: hidden; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif; background-color: var(--fallback-b1, oklch(var(--b1))); background-image: radial-gradient(circle at 78% 10%, color-mix(in oklab, var(--fallback-p, oklch(var(--p))) 9%, transparent), transparent 30rem), radial-gradient(circle at 20% 85%, color-mix(in oklab, var(--fallback-s, oklch(var(--s))) 7%, transparent), transparent 28rem); }
	[data-site-shell] { transition: filter .9s ease, transform .9s cubic-bezier(.2,.75,.2,1); }
	.intro-active [data-site-shell] { filter: blur(10px); transform: scale(.985); }
	.intro-releasing [data-site-shell] { filter: none; transform: none; }
	.site-topbar { box-shadow: 0 .5rem 2rem color-mix(in oklab, var(--fallback-bc, oklch(var(--bc))) 4%, transparent); }
	.site-main h1, .site-main h2, .site-main h3 { letter-spacing: -.025em; }
	.card { border-radius: 1.5rem; box-shadow: 0 1.1rem 3rem color-mix(in oklab, var(--fallback-bc, oklch(var(--bc))) 6%, transparent); backdrop-filter: blur(12px); transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease; }
	.card:hover { transform: translateY(-3px); border-color: color-mix(in oklab, var(--fallback-p, oklch(var(--p))) 35%, transparent); box-shadow: 0 1.4rem 3.4rem color-mix(in oklab, var(--fallback-p, oklch(var(--p))) 11%, transparent); }
	.btn { border-radius: 999px; }
	::selection { color: var(--fallback-pc, oklch(var(--pc))); background: var(--fallback-p, oklch(var(--p))); }
	.alert > span { min-width: 0; overflow-wrap: anywhere; }
	[data-reveal] {
		opacity: 1;
		transform: none;
		transition: opacity 650ms ease, transform 650ms cubic-bezier(.2,.7,.2,1);
	}
	.js [data-reveal]:not(.is-visible) { opacity: 0; transform: translateY(1.25rem); }
	.js [data-reveal].is-visible { opacity: 1; transform: none; }
	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		[data-reveal] { opacity: 1; transform: none; transition: none; }
	}
</style>
