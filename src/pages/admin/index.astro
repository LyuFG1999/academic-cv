---
import { template } from '../../settings';
const base = template.base;
---
<!doctype html>
<html lang="zh-CN" class="admin-page">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="referrer" content="no-referrer" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; worker-src 'self' blob:; frame-src 'self' about:; style-src 'self'; img-src 'self' blob: data: https:; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'none'" />
  <title>网站管理</title>
  <link rel="stylesheet" href={`${base}/admin/dashboard.css`} />
  <script>import '../../admin/dashboard.js';</script>
</head>
<body>
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <a class="brand" href={`${base}/admin/`}><span class="brand-mark" aria-hidden="true">A</span>网站管理</a>
      <nav id="section-nav" aria-label="设置分类"></nav>
      <div class="sidebar-footer">
        <a href={`${base}/zh/`} target="_blank" rel="noopener">查看网站 ↗</a>
        <a href="https://github.com/LyuFG1999/academic-cv/actions" target="_blank" rel="noopener">发布记录 ↗</a>
        <button id="account" type="button">登录后台</button>
      </div>
    </aside>
    <main>
      <header class="toolbar">
        <div><p class="toolbar-eyebrow">管理中心</p><h1 id="panel-title">欢迎回来</h1><p id="status" role="status" aria-live="polite">请登录后编辑。</p></div>
        <div class="toolbar-actions">
          <button id="discard-draft" type="button" class="quiet" disabled>放弃修改</button>
          <button id="save-draft" type="button" disabled>保存本地草稿</button>
          <button id="save" type="submit" form="settings-form" class="primary" disabled>发布修改</button>
        </div>
      </header>
      <div id="login-panel" class="welcome">
        <div class="welcome-mark" aria-hidden="true">A</div>
        <h2>你的学术空间</h2>
        <p>管理个人资料、研究成果与写作。</p>
        <button id="oauth-login" type="button" class="primary">使用 GitHub 登录</button>
        <p id="auth-help" class="hint">正在读取登录配置…</p>
        <details class="login-help"><summary>备用方式：仅授权本仓库的临时令牌</summary>
          <form id="token-login" class="token-form">
            <label class="field"><span>GitHub 细粒度访问令牌（不是 GitHub 密码）</span>
              <input id="github-token" type="password" required autocomplete="off" spellcheck="false" placeholder="github_pat_…" />
            </label><button type="submit">使用令牌登录</button>
          </form>
          <p class="hint">仅在自己的设备上使用。令牌只留在当前页面内存，刷新后需重新登录；不会写入草稿、仓库或链接。请勿把令牌发给他人。</p>
          <ol>
            <li><a class="external-setting" href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer">打开 GitHub 令牌创建页 ↗</a>，设置较短有效期（如 30 天）。</li>
            <li>Repository access 选择 Only select repositories，只勾选 academic-cv。</li>
            <li>Repository permissions 中 Contents 设为 Read and write，其余保持默认。生成后仅粘贴到上方输入框。</li>
          </ol>
        </details>
      </div>
      <form id="settings-form" novalidate hidden></form>
      <noscript>请启用 JavaScript 后管理网站。</noscript>
    </main>
  </div>
</body>
</html>
