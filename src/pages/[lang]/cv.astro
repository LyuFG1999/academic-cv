---
import Layout from '@/layouts/Layout.astro'
import CvTimeline from '@/components/ui/CvTimeline.astro'
import { renderMarkdown } from '@/lib/markdown.js'
import { copy, isLanguage, languages } from '@/i18n'
import { cv } from '@/data/cv'
import { profile, template } from '@/settings'
import { compareByAcademicDate } from '@/lib/utils'

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }))
}

const rawLang = Astro.params.lang
if (!isLanguage(rawLang)) throw new Error(`Unsupported language: ${rawLang}`)
const lang = rawLang
const t = copy[lang]
const person = profile[lang]
const data = cv[lang]

const experiences = [...data.experiences].sort(compareByAcademicDate)
const education = [...data.education].sort(compareByAcademicDate)
const content = renderMarkdown(data.content, { base: template.base, headingOffset: 1 })
const isEmpty = !experiences.length && !education.length && !data.content.trim()
---

<Layout lang={lang} title={`${t.cv} | ${person.fullName}`}>
	<header class='mb-12' data-reveal>
		<p class='text-sm font-semibold uppercase tracking-[0.2em] text-secondary'>{t.cv}</p>
		<h1 class='mt-3 text-4xl font-black'>{person.fullName}</h1>
		<p class='mt-3 text-lg text-base-content/65'>{person.title}</p>
	</header>

	{isEmpty && <div class='alert border border-base-300 bg-base-200/70' data-reveal><span>{t.emptyCv}</span></div>}
	{education.length > 0 && (
		<section class='mb-14' data-reveal>
			<div class='mb-7 flex items-center gap-3'>
				<div class='h-px w-8 bg-secondary/55'></div>
				<h2 class='text-2xl font-bold'>{t.education}</h2>
			</div>
			<CvTimeline elements={education} colored={true} />
		</section>
	)}
	{experiences.length > 0 && (
		<section class='mb-14' data-reveal>
			<div class='mb-7 flex items-center gap-3'>
				<div class='h-px w-8 bg-secondary/55'></div>
				<h2 class='text-2xl font-bold'>{t.experiences}</h2>
			</div>
			<CvTimeline elements={experiences} colored={true} />
		</section>
	)}
	{data.content.trim() && <div class='cv-markdown prose prose-base max-w-none prose-headings:text-base-content prose-p:text-base-content/80 prose-a:text-secondary prose-strong:text-base-content prose-li:text-base-content/80 prose-th:text-base-content prose-td:text-base-content/80' set:html={content} />}
</Layout>

<style>
 .cv-markdown :global(h2) { font-size: 1.5rem; line-height: 2rem; font-weight: 700; margin-top: 3rem; margin-bottom: 1.5rem; padding-bottom: .75rem; border-bottom: 1px solid var(--fallback-b3, oklch(var(--b3))); }
 .cv-markdown :global(h2:first-child) { margin-top: 0; }
 .cv-markdown :global(h3) { font-size: 1.25rem; }
</style>
