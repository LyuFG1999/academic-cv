---
import Layout from '@/layouts/Layout.astro'
import { copy, isLanguage, languages } from '@/i18n'
import { profile, template } from '@/settings'
import { getCollection } from 'astro:content'

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }))
}

const rawLang = Astro.params.lang
if (!isLanguage(rawLang)) throw new Error(`Unsupported language: ${rawLang}`)
const lang = rawLang
const t = copy[lang]
const person = profile[lang]
const posts = (await getCollection('blog'))
	.filter((post) => post.data.language === lang && !post.data.draft)
	.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
---

<Layout lang={lang} title={`${t.news} | ${person.fullName}`}>
	<header class='mb-10' data-reveal>
		<p class='text-sm font-semibold uppercase tracking-[0.2em] text-secondary'>{t.news}</p>
		<h1 class='mt-3 text-4xl font-black'>{t.news}</h1>
	</header>

	{posts.length > 0 ? (
		<div class='grid gap-6'>
			{posts.map((post) => (
				<article class='card overflow-hidden border border-base-300 bg-base-200/70 shadow-sm' data-reveal>
					{post.data.featuredImage && <img src={`${template.base}${post.data.featuredImage}`} alt='' class='h-52 w-full object-cover' loading='lazy' />}
					<div class='card-body'>
						<time class='text-sm text-base-content/60' datetime={post.data.date}>{new Date(post.data.date).toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
						<h2 class='card-title text-2xl'><a class='hover:text-secondary' href={`${template.base}/${lang}/news/${post.id}/`}>{post.data.title}</a></h2>
						<p class='text-base-content/75'>{post.data.excerpt}</p>
						<div class='card-actions mt-2 justify-end'><a class='btn btn-secondary btn-sm' href={`${template.base}/${lang}/news/${post.id}/`}>{t.readMore}</a></div>
					</div>
				</article>
			))}
		</div>
	) : (
		<div class='alert border border-base-300 bg-base-200/70' data-reveal><span>{t.noNews}</span></div>
	)}
</Layout>
