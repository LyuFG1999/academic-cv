---
import '@/styles/typography.css'
import Layout from '@/layouts/Layout.astro'
import { copy, isLanguage, languages } from '@/i18n'
import { profile } from '@/settings'
import { safeHttpUrl } from '@/lib/utils'

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })) }
const rawLang = Astro.params.lang
if (!isLanguage(rawLang)) throw new Error(`Unsupported language: ${rawLang}`)
const lang = rawLang
const t = copy[lang]
const person = profile[lang]
---

<Layout lang={lang} title={`${t.research} | ${person.fullName}`}>
	<header class='mb-12' data-reveal>
		<p class='text-sm font-semibold uppercase tracking-[0.2em] text-secondary'>{t.research}</p>
		<h1 class='sr-only'>{t.research}</h1>
	</header>
	<section data-reveal><h2 class='section-title'>{t.researchStatement}</h2><p class='text-lead'>{person.researchStatement}</p></section>
	<section class='section-flow' data-reveal>
		<h2 class='section-title'>{t.researchAreas}</h2>
		{person.researchAreas.length > 0 ? <div class='content-wide grid gap-4 sm:grid-cols-2'>{person.researchAreas.map((area) => <article class='rounded-xl border border-base-300 bg-base-200/55 px-5 py-4 transition hover:border-secondary/35 hover:bg-base-200'><h3 class='text-base font-semibold leading-7 text-base-content'>{area.title}</h3>{area.description && <p class='mt-2 text-base leading-8 text-base-content/78'>{area.description}</p>}</article>)}</div> : <div class='alert border border-base-300 bg-base-200/70'><span>{t.emptyResearch}</span></div>}
	</section>
	{person.projects.length > 0 && (
		<section class='section-flow' data-reveal>
			<h2 class='section-title'>{t.currentProjects}</h2>
			<div class='content-wide space-y-4'>
				{person.projects.map((project) => {
					const link = safeHttpUrl(project.link)
					const meta = [[t.projectSource, project.source],[t.projectCode, project.code],[t.projectStatus, project.status],[t.projectRole, project.role]].filter(([, value]) => value)
					return <article class='rounded-xl border border-base-300 bg-base-200/55 px-5 py-5 transition hover:border-secondary/35 hover:bg-base-200'>
						<div class='flex flex-wrap items-start justify-between gap-3'>
							<h3 class='text-lg font-semibold leading-7 text-base-content'>{link ? <a class='hover:text-secondary' href={link} target='_blank' rel='noopener noreferrer'>{project.title}</a> : project.title}</h3>
							{project.status && <span class='rounded-full border border-secondary/25 bg-secondary/10 px-3 py-1 text-xs font-semibold text-secondary'>{project.status}</span>}
						</div>
						{meta.length > 0 && <dl class='mt-4 grid gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-4'>{meta.map(([label, value]) => <div class='min-w-0'><dt class='text-xs font-semibold uppercase tracking-[0.08em] text-base-content/55'>{label}</dt><dd class='mt-1 break-words text-sm leading-6 text-base-content/85'>{value}</dd></div>)}</dl>}
						{project.description && <p class='mt-4 border-t border-base-300 pt-4 text-base leading-8 text-base-content/78'>{project.description}</p>}
					</article>
				})}
			</div>
		</section>
	)}
	{person.researchImpact && <section class='section-flow' data-reveal><h2 class='section-title'>{t.researchImpact}</h2><p class='text-lead'>{person.researchImpact}</p></section>}
</Layout>
