---
import Layout from '@/layouts/Layout.astro'
import { RESEARCH_ICONS } from '@/data/researchIcons'
import { copy, isLanguage, languages } from '@/i18n'
import { profile } from '@/settings'
import { safeHttpUrl } from '@/lib/utils'

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }))
}

const rawLang = Astro.params.lang
if (!isLanguage(rawLang)) throw new Error(`Unsupported language: ${rawLang}`)
const lang = rawLang
const t = copy[lang]
const person = profile[lang]
---

<Layout lang={lang} title={`${t.research} | ${person.fullName}`}>
	<article class='prose max-w-none prose-headings:text-base-content prose-p:text-base-content/80' data-reveal>
		<p class='text-sm font-semibold uppercase tracking-[0.2em] text-secondary'>{t.research}</p>
		<h1 class='mt-3 text-4xl font-black'>{t.researchStatement}</h1>
		<p class='lead mt-7'>{person.researchStatement}</p>
	</article>

	<section class='mt-14' data-reveal>
		<h2 class='mb-8 text-3xl font-bold'>{t.researchAreas}</h2>
		{person.researchAreas.length > 0 ? (
			<div class='grid gap-5 sm:grid-cols-2'>
				{person.researchAreas.map((area) => {
					const icon = RESEARCH_ICONS[area.field as keyof typeof RESEARCH_ICONS] || RESEARCH_ICONS['computer-science']
					return (
						<article class='group rounded-2xl border border-base-300 bg-base-200/65 p-6 transition hover:-translate-y-1 hover:border-secondary/35 hover:bg-base-200'>
							<div class='flex items-start gap-5'>
								<div class='grid size-14 shrink-0 place-items-center rounded-2xl border border-secondary/15 bg-secondary/10 text-3xl shadow-sm transition group-hover:scale-105' aria-hidden='true'>
									<span>{icon.emoji}</span>
								</div>
								<div class='min-w-0'>
									<h3 class='text-xl font-semibold'>{area.title}</h3>
									{area.description && <p class='mt-2 leading-relaxed text-base-content/72'>{area.description}</p>}
								</div>
							</div>
						</article>
					)
				})}
			</div>
		) : (
			<div class='alert border border-base-300 bg-base-200/70'><span>{t.emptyResearch}</span></div>
		)}
	</section>

	{person.projects.length > 0 && (
		<section class='mt-14' data-reveal>
			<h2 class='mb-8 text-3xl font-bold'>{t.currentProjects}</h2>
			<div class='grid gap-5 sm:grid-cols-2'>
				{person.projects.map((project) => {
					const link = safeHttpUrl(project.link)
					return (
					<article class='rounded-2xl border border-base-300 bg-base-200/70 p-6'>
						<h3 class='text-xl font-semibold'>{link ? <a class='hover:text-secondary' href={link} target='_blank' rel='noopener noreferrer'>{project.title}</a> : project.title}</h3>
						<p class='mt-3 text-base-content/75'>{project.description}</p>
					</article>
				)})}
			</div>
		</section>
	)}

	{person.researchImpact && (
		<section class='prose mt-14 max-w-none prose-headings:text-base-content prose-p:text-base-content/80' data-reveal>
			<h2>{t.researchImpact}</h2>
			<p>{person.researchImpact}</p>
		</section>
	)}
</Layout>
