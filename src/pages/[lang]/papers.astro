---
import Layout from '@/layouts/Layout.astro'
import { copy, isLanguage, languages } from '@/i18n'
import { cv } from '@/data/cv'
import { profile } from '@/settings'
import { compareByAcademicDate, safeHttpUrl } from '@/lib/utils'
import { navigation, type PaperCategory } from '@/data/navigation'
import AuthorNames from '@/components/ui/AuthorNames.astro'

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }))
}

const rawLang = Astro.params.lang
if (!isLanguage(rawLang)) throw new Error(`Unsupported language: ${rawLang}`)
const lang = rawLang
const t = copy[lang]
const person = profile[lang]
const authorAliases = [profile.zh.authorName, profile.en.authorName, '吕风光', 'Fengguang Lyu']
	.flatMap((value) => value.split('|'))
	.map((value) => value.trim())
	.filter(Boolean)
	.filter((value, index, values) => values.indexOf(value) === index)
	.join('|')
const papers = cv[lang].publications
	.filter((paper) => navigation.paperVisibility[paper.category ?? 'published'])
	.sort(compareByAcademicDate)
const categories: Array<{ key: PaperCategory; label: string }> = [
	{ key: 'published', label: t.publishedPapers },
	{ key: 'working', label: t.workingPapers },
	{ key: 'book', label: t.books },
]
const sections = categories
	.map(({ key, label }) => ({ key, label, papers: papers.filter((paper) => (paper.category ?? 'published') === key) }))
	.filter((section) => section.papers.length > 0)
---

<Layout lang={lang} title={`${t.papers} | ${person.fullName}`}>
	<header class='mb-10' data-reveal>
		<p class='text-sm font-semibold uppercase tracking-[0.2em] text-secondary'>{t.papers}</p>
		<h1 class='mt-3 text-4xl font-black'>{t.publications}</h1>
	</header>

	{sections.length > 0 ? (
		<div class='publication-sections space-y-12'>
			{sections.map((section) => (
				<section data-reveal>
					<h2 class='mb-5 text-2xl font-bold'>{section.label}</h2>
					<div class='space-y-6'>
						{section.papers.map((paper) => {
							const link = safeHttpUrl(paper.link)
							return (
							<article class='publication-card card border border-base-300 bg-base-200/70 shadow-sm'>
								<div class='card-body'>
									<h3 class='publication-title card-title text-xl'>{link ? <a href={link} target='_blank' rel='noopener noreferrer' class='hover:text-secondary'>{paper.title}</a> : paper.title}</h3>
									<p class='publication-authors'><span class='font-medium'>{t.authors}:</span> <AuthorNames authors={paper.authors} authorName={authorAliases} /></p>
									<p class='publication-meta text-sm'><span class='italic'>{paper.journal}</span>{paper.time ? ` · ${paper.time}` : ''}</p>
									{paper.abstract && <p class='publication-abstract text-sm text-base-content/75'>{paper.abstract}</p>}
									{link && <div class='card-actions mt-3 justify-end'><a href={link} class='btn btn-secondary btn-sm' target='_blank' rel='noopener noreferrer'>{t.readPaper}</a></div>}
								</div>
							</article>
						)})}
					</div>
				</section>
			))}
		</div>
	) : (
		<div class='alert border border-base-300 bg-base-200/70' data-reveal><span>{t.emptyPapers}</span></div>
	)}
</Layout>

<style>
	.publication-sections,
	.publication-card,
	.publication-card :global(.card-body),
	.publication-title,
	.publication-title :global(a),
	.publication-authors,
	.publication-meta,
	.publication-abstract { min-width: 0; max-width: 100%; }
	.publication-title,
	.publication-title :global(a),
	.publication-authors,
	.publication-meta,
	.publication-abstract { white-space: normal; overflow-wrap: anywhere; word-break: normal; }
	@media (max-width: 640px) {
		.publication-sections { width: 100%; }
		.publication-sections :global(section) { width: 100%; }
		.publication-card :global(.card-body) { padding: 1rem; gap: .7rem; }
		.publication-title { font-size: 1.05rem; line-height: 1.55; display: block; }
		.publication-authors { font-size: .93rem; line-height: 1.65; }
		.publication-meta { line-height: 1.6; }
		.publication-abstract { line-height: 1.7; }
		.publication-card :global(.card-actions) { justify-content: flex-start; }
		.publication-card :global(.btn) { width: fit-content; max-width: 100%; }
	}
</style>
