---
import Layout from '@/layouts/Layout.astro'
import { copy, isLanguage } from '@/i18n'
import { profile, template } from '@/settings'
import { getCollection, render } from 'astro:content'
import { assetUrl } from '@/lib/utils'

export async function getStaticPaths() {
	const posts = await getCollection('blog')
	return posts
		.filter((post) => !post.data.draft)
		.map((post) => ({ params: { lang: post.data.language, slug: post.id }, props: { post } }))
}

const rawLang = Astro.params.lang
if (!isLanguage(rawLang)) throw new Error(`Unsupported language: ${rawLang}`)
const lang = rawLang
const t = copy[lang]
const { post } = Astro.props
const { Content } = await render(post)
const person = profile[lang]
---

<Layout lang={lang} title={`${post.data.title} | ${person.fullName}`} description={post.data.excerpt}>
	<article class='mx-auto max-w-3xl' data-reveal>
		<header class='mb-10 border-b border-base-300 pb-8'>
			<time class='text-sm text-base-content/60' datetime={post.data.date}>{new Date(post.data.date).toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
			<h1 class='mt-3 text-4xl font-black leading-tight'>{post.data.title}</h1>
			{post.data.tags && <div class='mt-5 flex flex-wrap gap-2'>{post.data.tags.map((tag: string) => <span class='badge badge-outline'>{tag}</span>)}</div>}
		</header>
		{post.data.featuredImage && <img src={assetUrl(post.data.featuredImage, template.base)} alt='' class='mb-10 max-h-[28rem] w-full rounded-2xl object-cover' />}
		<div class='prose max-w-none prose-headings:text-base-content prose-p:text-base-content/80 prose-a:text-secondary'><Content /></div>

		{post.data.attachments && post.data.attachments.length > 0 && (
			<section class='mt-12 border-t border-base-300 pt-8'>
				<h2 class='mb-4 text-2xl font-bold'>{t.attachments}</h2>
				<div class='flex flex-wrap gap-3'>
					{post.data.attachments.map((attachment) => (
						<a href={assetUrl(attachment.file, template.base)} class='btn btn-outline btn-secondary' download>
							<svg class='size-5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true'><path d='M12 3v12m0 0 4-4m-4 4-4-4M5 21h14' /></svg>
							{attachment.label}
						</a>
					))}
				</div>
			</section>
		)}
	</article>
</Layout>
