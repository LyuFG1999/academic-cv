---
import Layout from '@/layouts/Layout.astro'
import { template } from '@/settings'
---

<Layout lang="zh" title="404 - 页面未找到">
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center">
    <h1 class="text-9xl font-black text-base-content mb-4">404</h1>
    <h2 class="text-4xl font-bold text-base-content mb-8">页面未找到 · Page Not Found</h2>
      <p class="text-lg text-base-content/80 mb-8">
        抱歉，这个页面不存在或已移动。<br/>
        Sorry, this page does not exist or has moved.
      </p>
    <div class="flex gap-4">
      <a
        href={`${template.base}/zh/`}
        class="btn btn-primary text-primary-content"
      >
        返回首页 · Home
      </a>
      <button
        class="btn btn-outline btn-accent"
        onclick="history.back()"
      >
        返回上一页 · Back
      </button>
    </div>
  </div>
</Layout>
